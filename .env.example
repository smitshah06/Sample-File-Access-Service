# Required. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNING_SECRET=
QC_CALLBACK_TOKEN=

# First admin, created on first start if no admin exists yet (password: 12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional settings, with their defaults. Uncomment only to change one, and keep any
# comment on its own line: `docker run --env-file` treats text after a value as part of it.
# These are left commented so the Docker image's own defaults (e.g. DB_PATH=/data/...) win.
#
# Local development over plain http only:
# COOKIE_SECURE=false
#
# DB_PATH=sample_access.db
# STORAGE_DIR=storage
# PUBLIC_BASE_URL=http://localhost:8000
# DOWNLOAD_URL_TTL_SECONDS=300
# SESSION_TTL_HOURS=8
# MAX_UPLOAD_MB=10240
# UPLOAD_CHUNK_BYTES=16777216
#
# Uploads are refused (507) if they would leave less free disk than this:
# MIN_FREE_DISK_MB=1024
#
# FRONTEND_DIST=frontend/dist
#
# Interactive API docs at /api/docs (the Docker image turns them off):
# ENABLE_DOCS=true
